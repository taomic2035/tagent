<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="8dp">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal">
        <EditText android:id="@+id/base_url" android:layout_width="0dp" android:layout_weight="2"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:hint="base url" android:inputType="textUri" />
        <EditText android:id="@+id/model_name" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:textSize="12sp"
            android:hint="model" android:inputType="text" />
    </LinearLayout>

    <ScrollView android:id="@+id/scroller" android:layout_width="match_parent"
        android:layout_height="0dp" android:layout_weight="1" android:layout_marginTop="6dp">
        <TextView android:id="@+id/chat_log" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:textSize="14sp"
            android:fontFamily="monospace" android:lineSpacingExtra="3dp" />
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginTop="6dp">
        <EditText android:id="@+id/message" android:layout_width="0dp" android:layout_weight="1"
            android:layout_height="wrap_content" android:hint="说点什么…"
            android:imeOptions="actionSend" android:inputType="text" />
        <CheckBox android:id="@+id/thinking" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="思考"
            android:textSize="12sp" android:checked="false" />
        <Button android:id="@+id/send" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:text="发送" />
    </LinearLayout>
</LinearLayout>
